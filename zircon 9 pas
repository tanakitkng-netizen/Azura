    function getFirebaseErrorMessage(error) {
      const code = error && error.code;
      const messages = {
        'auth/email-already-in-use': 'อีเมลนี้ถูกใช้สมัครสมาชิกแล้ว',
        'auth/invalid-email': 'รูปแบบอีเมลไม่ถูกต้อง',
        'auth/missing-email': 'กรุณากรอกอีเมลเดียวกับที่ใช้สมัครสมาชิก',
        'auth/weak-password': 'รหัสผ่านไม่ปลอดภัยพอ กรุณาใช้รหัสผ่านที่ยาวขึ้น',
        'auth/user-not-found': 'ไม่พบบัญชีที่ใช้อีเมลนี้ กรุณาใช้อีเมลเดียวกับที่สมัครสมาชิก',
        'auth/wrong-password': 'รหัสผ่านไม่ถูกต้อง',
        'auth/invalid-credential': 'อีเมลหรือรหัสผ่านไม่ถูกต้อง',
        'auth/too-many-requests': 'พยายามหลายครั้งเกินไป กรุณารอสักครู่แล้วลองใหม่',
        'auth/popup-closed-by-user': 'คุณปิดหน้าต่างเข้าสู่ระบบ Google ก่อนดำเนินการเสร็จ',
        'auth/popup-blocked': 'เบราว์เซอร์บล็อกหน้าต่าง Google กรุณาอนุญาตป๊อปอัปแล้วลองใหม่',
        'auth/unauthorized-domain': 'โดเมนเว็บไซต์นี้ยังไม่ได้รับอนุญาตใน Firebase Authentication'
      };
      return messages[code] || (error && error.message) || 'เกิดข้อผิดพลาด กรุณาลองใหม่';
    }

    async function sendResetPasswordEmail() {
      showAuthMessage('');
      const forgotInput = document.getElementById('forgotEmailInput');
      const sendBtn = document.getElementById('btnSendResetEmail');
      const email = (forgotInput.value || document.getElementById('loginEmail').value || '').trim();

      if (!email) {
        showAuthMessage('กรุณากรอกอีเมลเดียวกับที่ใช้สมัครสมาชิก');
        forgotInput.focus();
        return;
      }

      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailPattern.test(email)) {
        showAuthMessage('รูปแบบอีเมลไม่ถูกต้อง กรุณากรอกอีเมลเดียวกับที่ใช้สมัครสมาชิก');
        forgotInput.focus();
        return;
      }

      sendBtn.disabled = true;
      try {
        await auth.sendPasswordResetEmail(email);
        document.getElementById('loginEmail').value = email;
        showAuthMessage(
          `หากอีเมล ${email} เป็นบัญชีที่สมัครสมาชิกไว้ ระบบได้ส่งลิงก์รีเซ็ตรหัสผ่านไปแล้ว กรุณาตรวจสอบกล่องข้อความ (รวมถึงโฟลเดอร์จดหมายขยะ)`,
          false
        );
      } catch (error) {
        showAuthMessage(getFirebaseErrorMessage(error));
      } finally {
        sendBtn.disabled = false;
      }
    }

    async function registerWithEmail(event) {
      event.preventDefault();
      showAuthMessage('');
      const name = document.getElementById('registerName').value.trim();
      const email = document.getElementById('registerEmail').value.trim();
      const password = document.getElementById('registerPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      if (!name) return showAuthMessage('กรุณาตั้งชื่อบัญชี');
      if (!/[A-Za-z]/.test(password) || !/[0-9]/.test(password) || password.length < 8) {
        return showAuthMessage('รหัสผ่านต้องมีตัวอักษรภาษาอังกฤษและตัวเลข รวมอย่างน้อย 8 ตัว');
      }
      if (password !== confirmPassword) return showAuthMessage('รหัสผ่านทั้งสองช่องไม่ตรงกัน');

      try {
        const credential = await auth.createUserWithEmailAndPassword(email, password);
        await credential.user.updateProfile({ displayName: name });
        await credential.user.reload();
        showAuthMessage('สมัครสมาชิกสำเร็จ', false);
      } catch (error) {
        showAuthMessage(getFirebaseErrorMessage(error));
      }
    }

