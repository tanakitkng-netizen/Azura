<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>zircon</title>
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Noto+Sans+Thai:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #fafafa;
      --surface: #ffffff;
      --surface-subtle: #f4f4f5;
      --text: #18181b;
      --text-muted: #71717a;
      --border: #e4e4e7;
      --accent: #18181b;
      --accent-hover: #27272a;
      --danger: #dc2626;
      --success: #15803d;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', 'Noto Sans Thai', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      font-size: 14px;
      line-height: 1.6;
    }

    .mono {
      font-family: 'JetBrains Mono', monospace;
    }

    header {
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      padding: 16px 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .logo {
      font-size: 20px;
      font-weight: 600;
      letter-spacing: -0.04em;
      color: var(--text);
      text-decoration: none;
      user-select: none;
    }

    .nav-tabs {
      display: flex;
      gap: 4px;
      background: var(--surface-subtle);
      padding: 3px;
      border-radius: 8px;
    }

    .nav-tab {
      background: transparent;
      border: none;
      color: var(--text-muted);
      padding: 6px 14px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 400;
      transition: all 0.15s ease;
    }

    .nav-tab.active {
      background: var(--surface);
      color: var(--text);
      font-weight: 500;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    .user-area {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: var(--text-muted);
    }

    .user-area img {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      object-fit: cover;
    }

    .btn-ghost {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      cursor: pointer;
      transition: 0.15s;
    }

    .btn-ghost:hover {
      color: var(--text);
      border-color: #a1a1aa;
    }

    main {
      max-width: 820px;
      width: 100%;
      margin: 40px auto;
      padding: 0 20px 80px;
      flex: 1;
    }

    .auth-box {
      max-width: 390px;
      margin: 56px auto;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 34px 28px;
      text-align: center;
    }

    .auth-box h1 {
      font-size: 18px;
      font-weight: 500;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }

    .auth-box p {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 22px;
      font-weight: 300;
    }

    .google-btn {
      width: 100%;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 11px 16px;
      font-size: 13.5px;
      font-weight: 500;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .google-btn:hover {
      background: var(--surface-subtle);
      border-color: #d4d4d8;
    }

    .google-btn svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .auth-sub {
      margin-top: 18px;
      font-size: 11.5px;
      color: var(--text-muted);
      font-weight: 300;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 16px;
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
      gap: 8px;
    }

    .card-title {
      font-size: 14px;
      font-weight: 500;
      color: var(--text);
    }

    .tag {
      font-size: 11.5px;
      color: var(--text-muted);
      background: var(--surface-subtle);
      padding: 3px 9px;
      border-radius: 6px;
    }

    .input-group {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .input-field {
      flex: 1;
      min-width: 220px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 14px;
      color: var(--text);
      outline: none;
      transition: border-color 0.15s;
    }

    .input-field:focus {
      border-color: var(--text);
    }

    .input-field:disabled {
      background: var(--surface-subtle);
      color: var(--text-muted);
      cursor: not-allowed;
    }

    .btn-dark {
      background: var(--accent);
      color: #ffffff;
      border: none;
      border-radius: 8px;
      padding: 10px 18px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s;
    }

    .btn-dark:hover:not(:disabled) {
      background: var(--accent-hover);
    }

    .btn-dark:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    .btn-cancel-order {
      background: #ffffff;
      color: var(--danger);
      border: 1px solid #fecaca;
      border-radius: 8px;
      padding: 10px 18px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: 0.15s;
    }

    .btn-cancel-order:hover:not(:disabled) {
      background: #fef2f2;
      border-color: var(--danger);
    }

    .btn-cancel-order:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    .timer-box {
      text-align: center;
      padding: 28px 16px;
      background: var(--surface-subtle);
      border-radius: 10px;
    }

    .timer-label {
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 6px;
      font-weight: 400;
    }

    .timer-digits {
      font-size: clamp(36px, 6vw, 52px);
      font-weight: 400;
      letter-spacing: -0.02em;
      color: var(--text);
      margin-bottom: 20px;
    }

    .timer-actions {
      display: flex;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn-outline {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 18px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: 0.15s;
    }

    .btn-outline:hover:not(:disabled) {
      border-color: var(--text);
    }

    .btn-outline:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    th, td {
      padding: 11px 8px;
      text-align: left;
      border-bottom: 1px solid var(--border);
      font-weight: 400;
    }

    th {
      color: var(--text-muted);
      font-size: 12px;
    }

    .note-cancelled {
      color: var(--danger);
      font-weight: 500;
    }

    .note-normal {
      color: var(--text-muted);
    }

    .error-text {
      color: var(--danger);
      font-size: 12px;
      margin-top: 8px;
      display: none;
    }

    .hidden {
      display: none !important;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(24, 24, 27, 0.45);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 100;
    }

    .modal-card {
      width: 100%;
      max-width: 420px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 24px;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    }

    .modal-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 10px;
      line-height: 1.5;
    }

    .modal-warning {
      font-size: 13px;
      color: var(--danger);
      font-weight: 500;
      margin-bottom: 20px;
      line-height: 1.6;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }

    .auth-tabs {
      display: flex;
      gap: 4px;
      padding: 4px;
      margin-bottom: 28px;
      border-radius: 10px;
      background: var(--surface-subtle);
    }
    .auth-tab {
      flex: 1;
      border: 0;
      border-radius: 8px;
      padding: 10px 8px;
      background: transparent;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 13px;
    }
    .auth-tab.active {
      background: #fff;
      color: var(--text);
      box-shadow: 0 1px 4px rgba(0,0,0,.08);
      font-weight: 600;
    }
    .auth-panel { display: none; text-align: left; }
    .auth-panel.active { display: block; }
    .auth-panel h1 { text-align: left; }
    .auth-panel .auth-description {
      text-align: left;
      margin-bottom: 18px;
    }
    .auth-panel form { display: flex; flex-direction: column; gap: 12px; }
    .auth-submit { width: 100%; margin-top: 2px; }
    .forgot-trigger-row {
      display: flex;
      justify-content: flex-end;
      margin-top: -4px;
    }
    .forgot-link {
      background: transparent;
      border: 0;
      color: var(--text-muted);
      font-size: 12px;
      cursor: pointer;
      padding: 2px 0;
      transition: color 0.15s;
    }
    .forgot-link:hover {
      color: var(--text);
      text-decoration: underline;
    }
    .forgot-box {
      padding: 16px;
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .forgot-box-label {
      font-size: 12px !important;
      color: var(--text-muted) !important;
      margin: 0 !important;
      line-height: 1.5;
    }
    .auth-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--text-muted);
      font-size: 12px;
      margin: 18px 0;
    }
    .auth-divider::before, .auth-divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--border);
    }
    .password-hint {
      margin: -4px 0 0 !important;
      font-size: 11px !important;
      line-height: 1.5;
      text-align: left;
    }
    #authError { margin-top: 12px; }
    .success-text { color: #15803d !important; }

    .reset-inline-box {
      max-width: 390px;
      margin: 56px auto;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 32px 26px;
      text-align: left;
    }
    .reset-inline-box h1 {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 6px;
    }
    .reset-inline-box .desc {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 14px;
      font-weight: 300;
    }
    .reset-account-pill {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px 12px;
      font-size: 12.5px;
      color: var(--text);
      margin-bottom: 14px;
      word-break: break-all;
      display: none;
    }
    .reset-inline-box form {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .reset-msg {
      margin-top: 12px;
      font-size: 12px;
      display: none;
      line-height: 1.5;
    }
    .reset-msg.error {
      display: block;
      color: var(--danger);
    }
    .reset-msg.success {
      display: block;
      color: var(--success);
    }
    .reset-back-btn {
      margin-top: 16px;
      background: transparent;
      border: 0;
      color: var(--text-muted);
      font-size: 12.5px;
      cursor: pointer;
      padding: 0;
      text-decoration: underline;
    }
    .reset-back-btn:hover {
      color: var(--text);
    }

    @media (max-width: 480px) {
      .auth-box, .reset-inline-box { margin: 28px 14px; padding: 24px 18px; }
    }
  </style>
</head>
<body>

  <header>
    <a href="#" class="logo" onclick="returnToMainApp(event)">zircon</a>

    <div id="navTabs" class="nav-tabs hidden">
      <button class="nav-tab active" onclick="switchTab('rental')">เช่ารหัส</button>
      <button class="nav-tab" onclick="switchTab('history')">รายการยืนยัน</button>
    </div>

    <div id="userArea" class="user-area hidden">
      <img id="userAvatar" src="" alt="" />
      <span id="userName"></span>
      <button class="btn-ghost" onclick="logout()">ออกจากระบบ</button>
    </div>
  </header>

  <main>
    <section id="resetPasswordSection" class="reset-inline-box hidden">
      <h1>เปลี่ยนรหัสผ่าน</h1>
      <p id="resetStatusDesc" class="desc">กำลังตรวจสอบลิงก์สำหรับเปลี่ยนรหัสผ่าน...</p>
      <div id="resetAccountEmail" class="reset-account-pill mono"></div>

      <form id="resetPasswordForm" onsubmit="handleConfirmResetPassword(event)" style="display:none;">
        <input
          type="password"
          id="resetNewPassword"
          class="input-field"
          placeholder="รหัสผ่านใหม่"
          autocomplete="new-password"
          minlength="8"
          required
        />
        <p class="password-hint">รหัสผ่านต้องมีตัวอักษรภาษาอังกฤษอย่างน้อย 1 ตัว และตัวเลขอย่างน้อย 1 ตัว รวมไม่น้อยกว่า 8 ตัว</p>
        <input
          type="password"
          id="resetConfirmPassword"
          class="input-field"
          placeholder="ยืนยันรหัสผ่านใหม่อีกครั้ง"
          autocomplete="new-password"
          minlength="8"
          required
        />
        <button type="submit" id="btnSubmitResetPassword" class="btn-dark">ยืนยันการเปลี่ยนรหัสผ่าน</button>
      </form>

      <p id="resetMessageBox" class="reset-msg" role="alert"></p>
      <button type="button" class="reset-back-btn" onclick="returnToMainApp(event)">กลับไปหน้าเข้าสู่ระบบ</button>
      <div class="auth-sub">ใช้งานระบบฟรีได้ตลอด</div>
    </section>

    <section id="authSection" class="auth-box">
      <div id="authTabs" class="auth-tabs">
        <button type="button" class="auth-tab active" id="loginTab" onclick="switchAuthTab('login')">เข้าสู่ระบบ</button>
        <button type="button" class="auth-tab" id="registerTab" onclick="switchAuthTab('register')">สมัครสมาชิก</button>
      </div>

      <div id="loginPanel" class="auth-panel active">
        <div id="loginFormContainer">
          <h1>เข้าสู่ระบบ zircon</h1>
          <p class="auth-description">เข้าสู่ระบบเพื่อใช้งานบริการ zircon</p>
          <form onsubmit="loginWithEmail(event)">
            <input type="email" id="loginEmail" class="input-field" placeholder="อีเมล" autocomplete="email" required />
            <input type="password" id="loginPassword" class="input-field" placeholder="รหัสผ่าน" autocomplete="current-password" required />
            <div class="forgot-trigger-row">
              <button type="button" class="forgot-link" onclick="openForgotPasswordView()">ลืมรหัสผ่าน?</button>
            </div>
            <button type="submit" class="btn-dark auth-submit">เข้าสู่ระบบด้วยอีเมล</button>
          </form>

          <div class="auth-divider">หรือ</div>
          <button type="button" class="google-btn" onclick="handleGoogleButtonClick()">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.7 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.8C6.2 7.2 8.9 5 12 5z"/>
              <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.6l3.7 2.9c2.2-2 3.7-5 3.7-8.7z"/>
              <path fill="#FBBC05" d="M5.3 14.8c-.2-.7-.4-1.5-.4-2.3s.2-1.6.4-2.3L1.6 7.4C.6 9.4 0 11.6 0 14s.6 4.6 1.6 6.6l3.7-2.8z"/>
              <path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.1 0-5.8-2.1-6.7-5l-3.7 2.8C3.5 21.4 7.4 24 12 24z"/>
            </svg>
            เข้าสู่ระบบผ่าน Google
          </button>
        </div>

        <div id="forgotPasswordBox" class="forgot-box hidden">
          <h1>ลืมรหัสผ่าน</h1>
          <p class="forgot-box-label">กรอกอีเมลเดียวกับที่ใช้สมัครสมาชิก ระบบจะส่งลิงก์สำหรับตั้งรหัสผ่านใหม่ไปยังอีเมลนั้น</p>
          <input
            type="email"
            id="forgotEmailInput"
            class="input-field"
            placeholder="อีเมลเดียวกับที่ใช้สมัครสมาชิก"
            autocomplete="email"
          />
          <div class="forgot-trigger-row">
            <button type="button" class="forgot-link" onclick="backToLoginView()">ย้อนกลับ</button>
          </div>
          <button type="button" id="btnSendResetEmail" class="btn-dark auth-submit" onclick="sendResetPasswordEmail()">ส่งลิงก์รีเซ็ตรหัสผ่าน</button>
        </div>
      </div>

      <div id="registerPanel" class="auth-panel">
        <h1>สร้างบัญชีใหม่</h1>
        <p class="auth-description">ตั้งชื่อบัญชี อีเมล และรหัสผ่านเพื่อเข้าใช้บริการ zircon</p>
        <form onsubmit="registerWithEmail(event)">
          <input type="text" id="registerName" class="input-field" placeholder="ตั้งชื่อบัญชี" autocomplete="username" maxlength="40" required />
          <input type="email" id="registerEmail" class="input-field" placeholder="กรอกอีเมล" autocomplete="email" required />
          <input type="password" id="registerPassword" class="input-field" placeholder="ตั้งรหัสผ่าน" autocomplete="new-password" minlength="8" required />
          <p class="password-hint">รหัสผ่านต้องมีตัวอักษรภาษาอังกฤษอย่างน้อย 1 ตัว และตัวเลขอย่างน้อย 1 ตัว รวมไม่น้อยกว่า 8 ตัว</p>
          <input type="password" id="confirmPassword" class="input-field" placeholder="ยืนยันรหัสผ่านอีกครั้ง" autocomplete="new-password" required />
          <button type="submit" class="btn-dark auth-submit">สมัครสมาชิก</button>
        </form>
      </div>

      <p id="authError" class="error-text" role="alert"></p>
      <div class="auth-sub">ใช้งานระบบฟรีได้ตลอด</div>
    </section>

    <section id="appSection" class="hidden">
      <div id="tab-rental">
        <div class="card">
          <div class="card-header">
            <span class="card-title">เลขออเดอร์ทำรายการ</span>
          </div>

          <div class="input-group">
            <input
              type="text"
              id="orderInput"
              class="input-field mono"
              placeholder="กรอกเลขออเดอร์"
            />
            <button id="btnConfirmOrder" class="btn-dark" onclick="parseAndConfirmOrder()">ยืนยันรายการ</button>
          </div>
          <p id="orderError" class="error-text"></p>
        </div>

        <div class="card">
          <div class="card-header">
            <span class="card-title">เวลาคงเหลือ</span>
            <span id="rentalBadge" class="tag">รอดำเนินการ</span>
          </div>

          <div class="timer-box">
            <div id="timerStatusText" class="timer-label">ยืนยันเลขออเดอร์เพื่อเตรียมเริ่มนับเวลา</div>
            <div id="timerClock" class="timer-digits mono">00:00:00</div>

            <div class="timer-actions">
              <button id="btnToggleTimer" class="btn-dark" onclick="toggleRentalTimer()" disabled>
                เริ่มนับเวลา
