    async function initInlinePasswordReset() {
      const resetSec = document.getElementById('resetPasswordSection');
      const authSec = document.getElementById('authSection');
      const appSec = document.getElementById('appSection');
      const userArea = document.getElementById('userArea');
      const navTabs = document.getElementById('navTabs');

      resetSec.classList.remove('hidden');
      authSec.classList.add('hidden');
      appSec.classList.add('hidden');
      userArea.classList.add('hidden');
      navTabs.classList.add('hidden');

      const descEl = document.getElementById('resetStatusDesc');
      const emailBox = document.getElementById('resetAccountEmail');
      const formEl = document.getElementById('resetPasswordForm');

      try {
        const email = await auth.verifyPasswordResetCode(actionOobCode);
        descEl.textContent = 'กรอกรหัสผ่านใหม่ที่ต้องการใช้งาน';
        emailBox.textContent = `บัญชี: ${email}`;
        emailBox.style.display = 'block';
        formEl.style.display = 'flex';
        document.getElementById('resetNewPassword').focus();
      } catch (error) {
        descEl.textContent = 'ไม่สามารถใช้ลิงก์นี้ได้';
        setResetFeedback('ลิงก์เปลี่ยนรหัสผ่านไม่ถูกต้อง หมดอายุ หรือถูกใช้งานไปแล้ว กรุณาขอใหม่อีกครั้ง');
      }
    }

    async function handleConfirmResetPassword(event) {
      event.preventDefault();
      setResetFeedback('');

      const newPassword = document.getElementById('resetNewPassword').value;
      const confirmPassword = document.getElementById('resetConfirmPassword').value;
      const btn = document.getElementById('btnSubmitResetPassword');

      if (!/[A-Za-z]/.test(newPassword) || !/[0-9]/.test(newPassword) || newPassword.length < 8) {
        setResetFeedback('รหัสผ่านต้องมีตัวอักษรภาษาอังกฤษอย่างน้อย 1 ตัว และตัวเลขอย่างน้อย 1 ตัว รวมอย่างน้อย 8 ตัว');
        return;
      }

      if (newPassword !== confirmPassword) {
        setResetFeedback('รหัสผ่านทั้งสองช่องไม่ตรงกัน');
        return;
      }

      btn.disabled = true;
      try {
        await auth.confirmPasswordReset(actionOobCode, newPassword);
        document.getElementById('resetPasswordForm').style.display = 'none';
        document.getElementById('resetStatusDesc').textContent = 'เปลี่ยนรหัสผ่านเรียบร้อยแล้ว';
        setResetFeedback('เปลี่ยนรหัสผ่านใหม่สำเร็จ สามารถกลับไปเข้าสู่ระบบด้วยรหัสผ่านใหม่ได้ทันที', true);
      } catch (error) {
        const code = error && error.code;
        if (code === 'auth/weak-password') {
          setResetFeedback('รหัสผ่านไม่ปลอดภัยพอ กรุณาตั้งรหัสผ่านใหม่ที่คาดเดาได้ยากขึ้น');
        } else if (code === 'auth/expired-action-code' || code === 'auth/invalid-action-code') {
          setResetFeedback('ลิงก์นี้หมดอายุหรือถูกใช้งานไปแล้ว กรุณาขอลิงก์รีเซ็ตรหัสผ่านใหม่');
        } else {
          setResetFeedback('เกิดข้อผิดพลาดในการเปลี่ยนรหัสผ่าน กรุณาลองใหม่อีกครั้ง');
        }
      } finally {
        btn.disabled = false;
      }
    }

    function returnToMainApp(event) {
      if (event) event.preventDefault();
      isPasswordResetMode = false;
      document.getElementById('resetPasswordSection').classList.add('hidden');
