    const LETTER_DIGIT_MAP = {
      A: '0',
      B: '1',
      C: '2',
      D: '3',
      E: '4',
      F: '5',
      G: '6',
      H: '7',
      I: '8',
      J: '9',
      L: '1'
    };

    let activeOrder = null;
    let remainingSeconds = 0;
    let endAtTimestamp = null;
    let isRunning = false;
    let timerInterval = null;
    let orderHistory = [];

    function getUserStorageKey(uid, suffix) {
      return `zircon_${uid}_${suffix}`;
    }

    function readLocalUserCache(uid) {
      if (!uid) return { history: [], timer: null };
      try {
        const history = JSON.parse(localStorage.getItem(getUserStorageKey(uid, 'history')) || '[]');
        const timer = JSON.parse(localStorage.getItem(getUserStorageKey(uid, 'timer')) || 'null');
        return {
          history: Array.isArray(history) ? history : [],
          timer
        };
      } catch (e) {
        return { history: [], timer: null };
      }
    }

    function writeLocalUserCache(uid, historyList, timerState) {
      if (!uid) return;
      localStorage.setItem(getUserStorageKey(uid, 'history'), JSON.stringify(historyList || []));
      localStorage.setItem(getUserStorageKey(uid, 'timer'), JSON.stringify(timerState || null));
    }

    function decodeLetterDigits(letters) {
      let digits = '';
      for (const ch of letters.toUpperCase()) {
        if (!Object.prototype.hasOwnProperty.call(LETTER_DIGIT_MAP, ch)) {
          return null;
        }
        digits += LETTER_DIGIT_MAP[ch];
      }
      return digits;
    }

    function formatFullDuration(totalSeconds) {
      const safe = Math.max(0, Math.round(Number(totalSeconds || 0)));
      const hours = Math.floor(safe / 3600);
      const mins = Math.floor((safe % 3600) / 60);
      const secs = safe % 60;

      const parts = [];
      if (hours > 0) parts.push(`${hours} ชั่วโมง`);
      if (mins > 0) parts.push(`${mins} นาที`);
      if (secs > 0) parts.push(`${secs} วินาที`);
      return parts.length > 0 ? parts.join(' ') : '0 วินาที';
    }

    function formatFullConfirmedDateTime(dateObj) {
      const d = dateObj instanceof Date ? dateObj : new Date();
      const day = String(d.getDate()).padStart(2, '0');
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const yearBE = d.getFullYear() + 543;
      const hour = String(d.getHours()).padStart(2, '0');
      const min = String(d.getMinutes()).padStart(2, '0');
      return `${day}/${month}/${yearBE} ${hour}:${min}`;
    }

    function parseOrderString(raw) {
      const cleaned = raw.trim().toUpperCase();
      const regex = /^([A-Z])(\d+[A-Z]\d*)\.([A-Z]{2})-([A-Z]{2})(\d{2})\.(\d{2})$/;
      const match = cleaned.match(regex);
      if (!match) return null;

      const [, rentCode, durationCode, monthLetters, hourLetters, minStr, dayStr] = match;

      const durationMinutesDigits = durationCode.replace(/\D/g, '');
      const durationMinutes = parseInt(durationMinutesDigits, 10);
      if (!durationMinutes || durationMinutes <= 0) return null;

      const monthDigits = decodeLetterDigits(monthLetters);
      if (!monthDigits) return null;
      const monthNum = parseInt(monthDigits, 10);
      if (monthNum < 1 || monthNum > 12) return null;

      const hourDigits = decodeLetterDigits(hourLetters);
      if (!hourDigits) return null;
      const hourNum = parseInt(hourDigits, 10);
      const minNum = parseInt(minStr, 10);
      if (hourNum > 23 || minNum > 59) return null;

      const dayNum = parseInt(dayStr, 10);
      if (dayNum < 1 || dayNum > 31) return null;

      const totalSec = durationMinutes * 60;

      return {
        raw: cleaned,
        rentCode,
        month: monthDigits,
        orderTime: `${hourDigits}:${minStr}`,
        day: dayStr,
        durationLabel: formatFullDuration(totalSec),
        totalSeconds: totalSec
      };
    }

    function isOrderAlreadyUsed(orderCode) {
      const normalized = orderCode.trim().toUpperCase();
      return orderHistory.some(item => String(item.raw || '').trim().toUpperCase() === normalized);
    }

    async function persistUserStateToCloud() {
      if (!currentUser) return;
      const timerPayload = {
        activeOrder,
        remainingSeconds,
        endAtTimestamp,
        isRunning
      };
      writeLocalUserCache(currentUser.uid, orderHistory, timerPayload);
      try {
        await db.collection('users').doc(currentUser.uid).set({
          updatedAt: Date.now(),
          history: orderHistory,
          timer: timerPayload
        }, { merge: true });
      } catch (error) {
        // คงค่าใน local cache ไว้หากอัปโหลดชั่วคราวไม่สำเร็จ
      }
    }

    function applyUserDataState(data) {
      const nextHistory = Array.isArray(data && data.history) ? data.history : [];
      orderHistory = nextHistory;
      renderHistory();

      const saved = data && data.timer ? data.timer : null;
      if (saved && saved.activeOrder) {
        activeOrder = saved.activeOrder;
        remainingSeconds = Number(saved.remainingSeconds || 0);
        endAtTimestamp = saved.endAtTimestamp ? Number(saved.endAtTimestamp) : null;
        isRunning = Boolean(saved.isRunning);

        if (isRunning && endAtTimestamp) {
          stopTickerLoop();
          tickTimer(false);
          if (isRunning) {
            timerInterval = setInterval(() => tickTimer(true), 1000);
          }
        } else {
          stopTickerLoop();
          updateClockUI();
          if (remainingSeconds > 0) {
            document.getElementById('orderInput').value = activeOrder.raw || '';
            setOrderInputLocked(true);
            document.getElementById('rentalBadge').textContent = 'หยุดนับเวลา';
            document.getElementById('timerStatusText').textContent = 'หยุดนับเวลา';
            syncTimerControlsUI();
          } else {
            document.getElementById('orderInput').value = '';
            setOrderInputLocked(false);
            document.getElementById('rentalBadge').textContent = 'หมดเวลาเช่า';
            document.getElementById('timerStatusText').textContent = 'หมดเวลาเช่า';
            syncTimerControlsUI();
          }
        }
      } else {
        stopTickerLoop();
        activeOrder = null;
        remainingSeconds = 0;
        endAtTimestamp = null;
        isRunning = false;
        setOrderInputLocked(false);
        updateClockUI();
        document.getElementById('rentalBadge').textContent = 'รอดำเนินการ';
        document.getElementById('timerStatusText').textContent = 'ยืนยันเลขออเดอร์เพื่อเตรียมเริ่มนับเวลา';
        syncTimerControlsUI();
      }

      if (currentUser) {
        writeLocalUserCache(currentUser.uid, orderHistory, {
          activeOrder,
          remainingSeconds,
          endAtTimestamp,
          isRunning
        });
      }
    }

    function subscribeToUserCloudData(uid) {
      if (unsubscribeUserDoc) {
        unsubscribeUserDoc();
        unsubscribeUserDoc = null;
      }

      const cached = readLocalUserCache(uid);
      applyUserDataState(cached);

      unsubscribeUserDoc = db.collection('users').doc(uid).onSnapshot(
        (doc) => {
          if (doc.exists) {
            applyUserDataState(doc.data());
          } else {
            persistUserStateToCloud();
          }
        },
        () => {
          // ใช้ข้อมูลแคชในเครื่องหากเกิดข้อผิดพลาดในการเชื่อมต่อ
        }
      );
    }

    function parseAndConfirmOrder() {
      const errEl = document.getElementById('orderError');

      if (activeOrder && (remainingSeconds > 0 || isRunning)) {
        errEl.textContent = 'กรุณารอให้เวลาของรายการปัจจุบันหมดก่อน จึงจะยืนยันออเดอร์ใหม่ได้';
        errEl.style.display = 'block';
        setOrderInputLocked(true);
        return;
      }

      const inputVal = document.getElementById('orderInput').value;
      const parsed = parseOrderString(inputVal);

      if (!parsed) {
        errEl.textContent = 'รูปแบบเลขออเดอร์ไม่ถูกต้อง';
        errEl.style.display = 'block';
        return;
      }

      if (isOrderAlreadyUsed(parsed.raw)) {
        errEl.textContent = 'เลขออเดอร์นี้ถูกใช้งานไปแล้ว ไม่สามารถใช้ซ้ำได้';
        errEl.style.display = 'block';
        return;
      }

      errEl.style.display = 'none';
      stopTickerLoop();

      activeOrder = parsed;
      remainingSeconds = parsed.totalSeconds;
      endAtTimestamp = null;
      isRunning = false;

      document.getElementById('orderInput').value = parsed.raw;
      setOrderInputLocked(true);

      document.getElementById('rentalBadge').textContent = 'พร้อมใช้งาน';
      document.getElementById('timerStatusText').textContent = 'พร้อมเริ่มนับเวลา';
      updateClockUI();
      syncTimerControlsUI();

      orderHistory.unshift({
        raw: parsed.raw,
        rentCode: parsed.rentCode,
        totalSeconds: parsed.totalSeconds,
        durationLabel: parsed.durationLabel,
        confirmedAt: formatFullConfirmedDateTime(new Date()),
        status: 'active'
      });
      renderHistory();
      persistUserStateToCloud();
    }

    function formatSeconds(sec) {
      const safe = Math.max(0, Math.floor(sec));
      const h = Math.floor(safe / 3600);
      const m = Math.floor((safe % 3600) / 60);
      const s = safe % 60;
      return [h, m, s].map(v => String(v).padStart(2, '0')).join(':');
    }

    function updateClockUI() {
      document.getElementById('timerClock').textContent = formatSeconds(remainingSeconds);
    }

    function stopTickerLoop() {
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
    }

    function tickTimer(shouldSyncCloud = false) {
      if (!isRunning || !endAtTimestamp) return;

      const diffSec = Math.ceil((endAtTimestamp - Date.now()) / 1000);
      if (diffSec > 0) {
        remainingSeconds = diffSec;
        updateClockUI();
        if (activeOrder && document.getElementById('orderInput').value !== activeOrder.raw) {
          document.getElementById('orderInput').value = activeOrder.raw;
        }
        setOrderInputLocked(true);
        document.getElementById('rentalBadge').textContent = 'กำลังนับเวลา';
        document.getElementById('timerStatusText').textContent = 'กำลังนับเวลาถอยหลัง';
        syncTimerControlsUI();
        if (currentUser) {
          writeLocalUserCache(currentUser.uid, orderHistory, {
            activeOrder,
            remainingSeconds,
            endAtTimestamp,
            isRunning
          });
        }
      } else {
        remainingSeconds = 0;
        isRunning = false;
        endAtTimestamp = null;
        stopTickerLoop();
        updateClockUI();
        document.getElementById('orderInput').value = '';
        setOrderInputLocked(false);
        document.getElementById('rentalBadge').textContent = 'หมดเวลาเช่า';
        document.getElementById('timerStatusText').textContent = 'หมดเวลาเช่า';
        syncTimerControlsUI();
        if (shouldSyncCloud) {
          persistUserStateToCloud();
        }
      }
    }

    function startRentalTimer() {
      if (!activeOrder || remainingSeconds <= 0) return;

      isRunning = true;
      endAtTimestamp = Date.now() + remainingSeconds * 1000;

      setOrderInputLocked(true);
      document.getElementById('rentalBadge').textContent = 'กำลังนับเวลา';
      document.getElementById('timerStatusText').textContent = 'กำลังนับเวลาถอยหลัง';
      syncTimerControlsUI();

      stopTickerLoop();
      tickTimer(false);
      persistUserStateToCloud();
      timerInterval = setInterval(() => tickTimer(true), 1000);
    }

    function pauseRentalTimer() {
      if (isRunning && endAtTimestamp) {
        remainingSeconds = Math.max(0, Math.ceil((endAtTimestamp - Date.now()) / 1000));
      }
      isRunning = false;
      endAtTimestamp = null;
      stopTickerLoop();
      updateClockUI();

      if (activeOrder && remainingSeconds > 0) {
        setOrderInputLocked(true);
        document.getElementById('rentalBadge').textContent = 'หยุดนับเวลา';
        document.getElementById('timerStatusText').textContent = 'หยุดนับเวลา';
      } else {
        setOrderInputLocked(false);
      }
      syncTimerControlsUI();
      persistUserStateToCloud();
    }

    function toggleRentalTimer() {
      if (isRunning) {
        pauseRentalTimer();
      } else {
        startRentalTimer();
      }
    }

    function openCancelModal() {
      if (!activeOrder || remainingSeconds <= 0) return;
      document.getElementById('cancelModalTitle').textContent =
        `คุณต้องการยกเลิกรายการ ${activeOrder.raw} หรือไม่`;
      document.getElementById('cancelModal').classList.remove('hidden');
    }

    function closeCancelModal() {
      document.getElementById('cancelModal').classList.add('hidden');
    }

    function confirmCancelOrder() {
      if (!activeOrder) {
        closeCancelModal();
        return;
      }

      const targetOrderRaw = String(activeOrder.raw || '').trim().toUpperCase();
      orderHistory = orderHistory.map(item => {
        if (String(item.raw || '').trim().toUpperCase() === targetOrderRaw && item.status !== 'cancelled') {
          return {
            ...item,
            status: 'cancelled'
          };
        }
        return item;
      });

      stopTickerLoop();
      activeOrder = null;
      remainingSeconds = 0;
      endAtTimestamp = null;
      isRunning = false;

      document.getElementById('orderInput').value = '';
      document.getElementById('orderError').style.display = 'none';
      setOrderInputLocked(false);
      updateClockUI();
      document.getElementById('rentalBadge').textContent = 'ยกเลิกรายการแล้ว';
      document.getElementById('timerStatusText').textContent = 'ยกเลิกรายการเรียบร้อยแล้ว สามารถกรอกออเดอร์ใหม่ได้';
      syncTimerControlsUI();

      closeCancelModal();
      renderHistory();
      persistUserStateToCloud();
    }

    function getHistoryDurationText(item) {
      if (typeof item.totalSeconds === 'number' && item.totalSeconds > 0) {
        return formatFullDuration(item.totalSeconds);
      }
      if (item.raw) {
        const reparsed = parseOrderString(item.raw);
        if (reparsed) return reparsed.durationLabel;
      }
      return item.durationLabel || '-';
    }

    function renderHistory() {
      const tbody = document.getElementById('historyTableBody');
      document.getElementById('historyCount').textContent = `${orderHistory.length} รายการ`;
      if (!orderHistory.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" style="text-align:center; color:var(--text-muted); padding:24px 0;">ยังไม่มีรายการ</td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = orderHistory.map(item => {
        const isCancelled = item.status === 'cancelled';
        const noteHtml = isCancelled
          ? `<span class="note-cancelled">ถูกยกเลิก</span>`
          : `<span class="note-normal">-</span>`;

        return `
          <tr>
            <td class="mono">${item.raw || '-'}</td>
            <td class="mono">${item.rentCode || '-'}</td>
            <td>${getHistoryDurationText(item)}</td>
            <td class="mono">${item.confirmedAt || '-'}</td>
            <td>${noteHtml}</td>
          </tr>
        `;
      }).join('');
    }

    renderAuthState();
  </script>
</body>
</html>
